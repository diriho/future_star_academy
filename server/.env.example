# Copy this file to .env and fill in real values.

# Port the API server listens on. Ignored on Vercel, which owns the socket.
PORT=4000

# Origin of the frontend, used for Stripe redirect URLs and CORS.
# On Vercel this is optional: if unset, the deployment's own domain is used, so
# preview deploys redirect back to themselves. Set it explicitly once you attach a
# custom domain, otherwise donors land on the *.vercel.app address after paying.
CLIENT_URL=http://localhost:5173

# Stripe secret key (test or live) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret — from `stripe listen` (local) or the Stripe Dashboard (prod).
# This must be a whsec_… value. The publishable key (pk_…) is NOT a server secret —
# it belongs in future_star/.env as VITE_STRIPE_PUBLISHABLE_KEY.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Path to the SQLite database file. Resolves against the working directory, not this
# file. Serverless filesystems are read-only, so on Vercel the database simply does not
# open and the donation ledger is skipped — Stripe still records every payment.
DB_PATH=./data/donations.db

# Notion integration token — https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_replace_me

# ID of the Notion database powering the News & Events section (share the database with your integration first)
NOTION_DATABASE_ID=replace_me
