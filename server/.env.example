# Copy this file to .env and fill in real values.

# Port the API server listens on
PORT=4000

# Origin of the frontend dev/prod server, used for Stripe redirect URLs and CORS
CLIENT_URL=http://localhost:5173

# Stripe secret key (test or live) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret — from `stripe listen` (local) or the Stripe Dashboard (prod)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Path to the SQLite database file
DB_PATH=./data/donations.db
